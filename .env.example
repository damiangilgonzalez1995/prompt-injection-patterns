# ---------------------------------------------------------------------------
# Everything in this repo runs with NO keys at all (TEST_MODE=mock, default).
# Set these only if you want the patterns to talk to a real model.
# ---------------------------------------------------------------------------

# mock | live   -- mock uses the deterministic InjectableMockLLM (no network)
TEST_MODE=mock

# anthropic | openai
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
