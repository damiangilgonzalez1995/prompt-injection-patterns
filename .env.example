# Everything runs offline by default (PIP_MODE=mock). Set a key only to hit a
# real model.

# mock | live   -- mock uses the deterministic InjectableMockChatModel (no network)
PIP_MODE=mock

# openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
